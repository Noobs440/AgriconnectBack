generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  email       String?  @unique
  contact     String?  @unique
  password    String
  fullName    String?
  profileImage String?
  role        Role     @default(BUYER_PARTICULIER)
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  limitOrders LimitOrder[]
  orders      Order[]  @relation("BuyerOrders")
  products    Product[] @relation("SellerProducts")
}

model Product {
  id           String         @id @default(uuid())
  title        String
  description  String?
  price        Float
  category     String?
  quantity     Int            @default(0)
  images       String[]       @default([])
  location     String?
  sellerId     String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  limitOrders  LimitOrder[]   @relation("ProductLimitOrders")
  orderItems   OrderItem[]
  priceHistory PriceHistory[]
  seller       User           @relation("SellerProducts", fields: [sellerId], references: [id])
}

model Order {
  id          String      @id @default(uuid())
  buyerId     String
  status      OrderStatus @default(PENDING)
  totalAmount Float
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  buyer       User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  items       OrderItem[]
  payments    Payment[]
}

model PriceHistory {
  id         String   @id @default(uuid())
  productId  String
  price      Float
  recordedAt DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id])
}

model LimitOrder {
  id          String           @id @default(uuid())
  productId   String
  buyerId     String
  targetPrice Float
  quantity    Int
  status      LimitOrderStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  buyer       User             @relation(fields: [buyerId], references: [id])
  product     Product          @relation("ProductLimitOrders", fields: [productId], references: [id])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Float
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}

model Payment {
  id            String          @id @default(uuid())
  orderId       String
  provider      PaymentProvider
  status        PaymentStatus   @default(PENDING)
  amount        Float
  phoneNumber   String
  externalRefId String?         @unique
  rawCallback   Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  order         Order           @relation(fields: [orderId], references: [id])
}

enum Role {
  FARMER
  BUYER_PRO
  BUYER_PARTICULIER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum LimitOrderStatus {
  PENDING
  FILLED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentProvider {
  MTN_MOMO
  ORANGE_MONEY
}
